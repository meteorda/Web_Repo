{
  "name": "tw-stock-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "台股個股資料分析與 Groq AI 洞察系統",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node server/index.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:sample": "node scripts/gen-sample-csv.js",
    "postinstall": "node scripts/copy-pdfjs-assets.js",
    "predev": "node scripts/copy-pdfjs-assets.js",
    "prebuild": "node scripts/copy-pdfjs-assets.js"
  },
  "dependencies": {
    "apexcharts": "^4.0.0",
    "docx": "^9.0.0",
    "dompurify": "^3.1.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "marked": "^14.1.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^4.6.82"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.0",
    "jszip": "^3.10.2",
    "supertest": "^7.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
