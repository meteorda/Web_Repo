# 複製為 .env 後填入；.env 已列入 .gitignore，切勿提交真實金鑰
# 正式部署建議由伺服器環境變數提供金鑰
GROQ_API_KEY=

# 伺服器
PORT=8787
HOST=127.0.0.1
# NODE_ENV=production

# 是否允許前端輸入自己的金鑰（經代理轉送，不保存）
# 未設定時：開發模式 true、正式模式 false
# ALLOW_CLIENT_KEY=true

# 允許的來源（逗號分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787

# 上游逾時（毫秒）、請求大小、訊息字元上限、每 IP 每分鐘請求數
UPSTREAM_TIMEOUT_MS=60000
MAX_BODY_BYTES=204800
MAX_MESSAGE_CHARS=30000
RATE_LIMIT_PER_MIN=30
